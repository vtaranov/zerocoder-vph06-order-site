COMPOSE_PROJECT_NAME=vph04
PUBLIC_HOST=your-server.example.com
HTTPS_PORT=18443
TLS_LIVE_DIR=/etc/letsencrypt/live/your-server.example.com
TLS_ARCHIVE_DIR=/etc/letsencrypt/archive/your-server.example.com
POSTGRES_DB=orders
POSTGRES_USER=orders_app
POSTGRES_PASSWORD=replace-with-unique-password
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=replace-with-another-unique-password
REGISTRY_HTTP_SECRET=replace-with-random-hex-string
DOCKER_API_VERSION=1.44


SECRET_KEY=replace-with-secret-key
BOOTSTRAP_TOKEN=replace-with-bootstrap-token
ENABLE_DOCS=false
